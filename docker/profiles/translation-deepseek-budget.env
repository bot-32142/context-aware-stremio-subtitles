# CAT translation profile using the built-in DeepSeek budget config.
ENABLE_TRANSLATION=true
CAT_CLI_CMD=uvx --from git+https://github.com/bot-32142/context-aware-translation.git@v2.4.0 --python 3.12 --torch-backend cpu cat-cli
CAT_CONFIG=/data/cat-configs/deepseek-budget.yaml
CAT_NO_POLISH=true
CAT_LIBRARY_ROOT=/data/cat-library
TMP_DIR=/data/tmp
TRANSLATION_DIR=/data/translations
