HOST=0.0.0.0
PORT=7001

# Docker Compose-only conveniences.
# HOST_PORT controls the host-side port; the container still listens on 7001.
# ADDON_PROFILE_FILE can point to docker/profiles/public.env, all-providers.env,
# subdl.env, subsource.env, subsro.env, or wyzie.env.
# CAT_PROFILE_FILE can point to translation-deepseek-budget.env or translation-deepseek-balanced.env.
HOST_PORT=7001
ADDON_DATA_DIR=./data
ADDON_PROFILE_FILE=./docker/profiles/public.env
CAT_PROFILE_FILE=./docker/profiles/translation-deepseek-budget.env
# CAT_CONFIG_PATH is only needed with docker-compose.custom-cat-config.yml.
# CAT_CONFIG_PATH=/path/to/cat.yaml

# Optional. Set when a fixed LAN IP, reverse proxy, or hostname should be baked into returned subtitle URLs.
# BASE_URL=http://192.168.1.50:7001

# Source language codes used for subtitles to translate from.
SOURCE_LANGUAGES=eng
# Single target language used for both Stremio entries and CAT translation.
# Examples: Chinese, English, Spanish, Japanese, Korean, Traditional Chinese.
TARGET_LANGUAGE=Chinese

# Local storage for translation cache, CAT library, temporary files, and book registry.
DATA_DIR=./data

# Point this at the CLI from https://github.com/bot-32142/context-aware-translation/tree/v2.4.0.
# Example for a source checkout:
# CAT_CLI_CMD=uv --directory <path-to-context-aware-translation> run cat-cli
CAT_CLI_CMD=cat-cli
CAT_NO_POLISH=false

# Required for first-time book creation. Reused --book-id runs intentionally do not pass --config.
# Translation stays disabled by default until CAT is configured.
ENABLE_TRANSLATION=false
CAT_CONFIG=<path-to-cat-config>
CAT_LIBRARY_ROOT=./data/cat-library

MAX_SUBTITLES_PER_LANGUAGE=5
PROVIDER_TIMEOUT_MS=12000
ID_RESOLVER_TIMEOUT_MS=8000

# Comma-separated providers. Available: opensubtitles-v3, scs, subdl, subsource, subsro, wyzie.
# scs means Stremio Community Subtitles and uses a public manifest token by default.
SUBTITLE_PROVIDERS=opensubtitles-v3,scs

# Optional provider credentials.
SUBDL_API_KEY=
SUBSOURCE_API_KEY=
SUBSRO_API_KEY=
WYZIE_API_KEY=
SCS_MANIFEST_TOKEN=

# Optional CAT provider credentials. Required for the bundled DeepSeek translation profiles.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPL_API_KEY=

# Filtering/ranking behavior adapted from StremioSubMaker.
DEDUPLICATE_SUBTITLES=true
EXCLUDE_HEARING_IMPAIRED_SUBTITLES=false
